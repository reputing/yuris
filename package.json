{
  "name": "yuris",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply yuris --remote",
    "db:migrate:local": "wrangler d1 migrations apply yuris --local",
    "ingest:mangadex": "tsx scripts/ingest-mangadex.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "wrangler": "^4.168.0"
  }
}
